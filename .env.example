# Ingesta MQTT de sensores reales (gemelo SOL-TERRAZA).
# Copia este archivo a .env.local y completa los valores. SIN estas variables
# la app corre en modo simulado (fallback silencioso): no falla ni molesta.

# URL del broker por WebSocket. ws:// en local, wss:// en produccion. Vacio = deshabilitado.
VITE_MQTT_URL=

# Topico donde publica el nodo ESP32.
VITE_MQTT_TOPIC=solterraza/sensores

# Segundos sin mensaje tras los cuales la UI vuelve a SIMULADO.
VITE_MQTT_TIMEOUT=15

# Credenciales opcionales del broker.
VITE_MQTT_USER=
VITE_MQTT_PASS=
